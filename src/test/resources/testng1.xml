            <class name="apis_desacople.networkequipment.vas.NetworkEquipmentOntVasTest"/>
            <class name="apis_desacople.networkprojects.ProjectsTest"/>
            <class name="apis_desacople.networkprojects.SubProjectsTest"/>
            <class name="apis_desacople.networksites.NetworkSiteTest"/>
            <class name="apis_desacople.networksites.PortsTest"/>
            <class name="apis_desacople.qualification.QualificationHorizontalTest"/>
            <class name="apis_desacople.qualification.QualificationVerticalTest"/>
            <class name="apis_desacople.serviceactivations.ChecklistsTest"/>
            <class name="apis_desacople.services.OwnerChangesTest"/>
        </classes>
    </test>

    <!-- =========================================================
         BLOQUE 09: Activación extra antes de la desactivación final
         Garantiza que la ONT esté activa y vigente
         ========================================================= -->
    <test name="09_Activacion_Previa_Desactivacion_Final">
        <classes>
            <class name="apis_desacople.networkequipment.activations.NetworkEquipmentOntActivationsTest"/>
        </classes>
    </test>

    <!-- =========================================================
         BLOQUE FINAL: OntDesactivationTest
         ========================================================= -->
    <test name="99_Ultimo_Desactivacion_Por_Id">
        <classes>
            <class name="apis_desacople.networkequipment.OntDesactivationTest"/>
        </classes>
    </test>

</suite>